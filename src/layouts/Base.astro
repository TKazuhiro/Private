---
import '../styles/global.css';
import { site, nav } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  image?: string;
  publishedTime?: Date;
}
const { title, description = site.description, type = 'website', image, publishedTime } = Astro.props;
const fullTitle = title ? `${title}｜${site.title}` : `${site.title}｜${site.tagline}`;
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL(image ?? '/images/avatar-square.jpg', site.url).href;
const current = Astro.url.pathname;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="format-detection" content="telephone=no" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/images/logo_1.png" type="image/png" />
    <link rel="apple-touch-icon" href="/images/logo_1.png" />
    <link rel="alternate" type="application/rss+xml" title={site.title} href="/rss.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
  </head>
  <body>
    <header class="site-header">
      <div class="wrap site-header__in">
        <a class="brand" href="/">
          <span class="brand__name">{site.title}</span>
          <span class="brand__sub">{site.tagline}</span>
        </a>
        <nav class="gnav" aria-label="メイン">
          <ul>
            {nav.map((n) => (
              <li>
                <a href={n.href} aria-current={!n.external && current.startsWith(n.href) ? 'page' : undefined} target={n.external ? '_blank' : undefined} rel={n.external ? 'noopener' : undefined}>
                  {n.label}{n.external && <span aria-hidden="true"> ↗</span>}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap site-footer__in">
        <div>
          <p class="site-footer__name">{site.title}</p>
          <p class="small">{site.tagline}<br />書いている人: {site.author}／<a href={site.officeUrl} target="_blank" rel="noopener">{site.officeName}</a></p>
        </div>
        <ul class="site-footer__nav">
          {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
          {site.x && <li><a href={site.x} target="_blank" rel="noopener">X ↗</a></li>}
          {site.note && <li><a href={site.note} target="_blank" rel="noopener">note ↗</a></li>}
          <li><a href="/rss.xml">RSS</a></li>
          <li><a href="/privacy/">プライバシーポリシー</a></li>
        </ul>
      </div>
      <p class="copyright">© {new Date().getFullYear()} {site.name}</p>
    </footer>
  </body>
</html>

<style>
  .site-header { background: var(--surface); border-bottom: 1px solid var(--line); }
  .site-header__in { display: flex; align-items: center; justify-content: space-between; min-height: 64px; gap: 1rem; flex-wrap: wrap; padding-top: .4rem; padding-bottom: .4rem; }
  .brand { text-decoration: none; display: flex; flex-direction: column; line-height: 1.2; }
  .brand__name { font-weight: 800; color: var(--ink); font-size: 1.25rem; letter-spacing: .02em; }
  .brand__sub { font-size: .72rem; color: var(--muted); }
  .gnav ul { list-style: none; margin: 0; padding: 0; display: flex; gap: 1.1rem; flex-wrap: wrap; }
  .gnav a { text-decoration: none; font-size: .9rem; font-weight: 600; color: var(--ink-soft); padding: .3em 0; border-bottom: 2px solid transparent; }
  .gnav a:hover, .gnav a[aria-current="page"] { border-color: var(--accent); color: var(--accent-dark); }
  .site-footer { border-top: 1px solid var(--line); margin-top: 4rem; padding: 2.5rem 0 1rem; background: var(--surface); }
  .site-footer__in { display: flex; justify-content: space-between; gap: 2rem; flex-wrap: wrap; }
  .site-footer__name { font-weight: 800; margin-bottom: .3em; }
  .site-footer__nav { list-style: none; margin: 0; padding: 0; display: grid; gap: .3em; font-size: .9rem; }
  .site-footer__nav a { text-decoration: none; color: var(--ink-soft); }
  .copyright { text-align: center; font-size: .78rem; color: var(--muted); margin: 2rem 0 0; }
</style>
